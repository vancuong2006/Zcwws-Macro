<Window x:Class="Zcwws.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zcwws Slide Macro" Height="660" Width="460"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Background="#09090B">
    <Border BorderBrush="#27272A" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#18181B" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Status LED Indicator -->
                        <Ellipse x:Name="StatusLed" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" />
                        <TextBlock Text="Zcwws" Foreground="#FAFAFA" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="Slide Macro" Foreground="#A1A1AA" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Border Background="#27272A" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.5" Foreground="#A1A1AA" FontWeight="Medium" FontSize="10" />
                        </Border>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="⎯" Click="Minimize_Click" Style="{StaticResource WinCtrlStyle}" />
                        <Button Content="✕" Click="Close_Click" Style="{StaticResource WinCloseStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Container (No Scrollbar) -->
            <Grid Grid.Row="1" Margin="16,12,16,12">
                <StackPanel>

                    <!-- Engine Status Card -->
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Macro Engine Status" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="StatusSubtext" Text="Active • Ready in-game" Foreground="#10B981" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="ToggleMacroEnabled" Grid.Column="1" Style="{StaticResource ModernToggleStyle}" IsChecked="True" Checked="OnMacroToggleChanged" Unchecked="OnMacroToggleChanged" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Keybind Cards -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Trigger Key -->
                        <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Trigger Key" Foreground="#A1A1AA" FontSize="11" FontWeight="Medium" Margin="0,0,0,8" />
                                <Button x:Name="BtnTriggerKey" Content="[ C ]" Style="{StaticResource ModernKeybindStyle}" Click="OnStartTriggerBind" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Crouch Key -->
                        <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Crouch Key" Foreground="#A1A1AA" FontSize="11" FontWeight="Medium" Margin="0,0,0,8" />
                                <Button x:Name="BtnCrouchKey" Content="[ LeftCtrl ]" Style="{StaticResource ModernKeybindStyle}" Click="OnStartCrouchBind" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Requirements & Settings Card -->
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Require Sprint (W + Shift)" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Trigger only while sprinting forward" Foreground="#71717A" FontSize="10.5" Margin="0,1,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="ToggleRequireSprint" HorizontalAlignment="Right" Style="{StaticResource ModernToggleStyle}" IsChecked="True" Checked="OnConfigChanged" Unchecked="OnConfigChanged" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="#27272A" Margin="0,2,0,8" />

                            <!-- Hide under Taskbar (System Tray) Option -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hide under Taskbar (System Tray)" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Press [ HOME ] key anytime to Toggle Show / Hide tool" Foreground="#3B82F6" FontSize="10.5" Margin="0,1,0,0" FontWeight="Medium" />
                                </StackPanel>
                                <ToggleButton x:Name="ToggleMinimizeToTray" HorizontalAlignment="Right" Style="{StaticResource ModernToggleStyle}" IsChecked="False" Checked="OnConfigChanged" Unchecked="OnConfigChanged" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="#27272A" Margin="0,2,0,10" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Slide Duration" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock x:Name="TxtDelayValue" Text="25 ms" HorizontalAlignment="Right" Foreground="#3B82F6" FontWeight="Bold" FontSize="12" />
                            </Grid>
                            <Slider x:Name="SliderDelay" Style="{StaticResource ModernSliderStyle}" Minimum="15" Maximum="200" SmallChange="5" Value="25" ValueChanged="OnDelayValueChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Feature Specifications Card (Text Items) -->
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Korea Slide Technology" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" />
                            
                            <!-- Feature Text 1 -->
                            <Border Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Diagonal Directional Slide" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="11.5" />
                                    <TextBlock Text="Supports W+A left and W+D right diagonal momentum slides" Foreground="#A1A1AA" FontSize="10.5" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Feature Text 2 -->
                            <Border Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="Instant Stand-Up &amp; Sprint Recovery" Foreground="#10B981" FontWeight="SemiBold" FontSize="11.5" />
                                    <TextBlock Text="Automatic un-crouch recovery for both Hold and Toggle modes" Foreground="#A1A1AA" FontSize="10.5" Margin="0,0,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Optimization Tip Card -->
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Optimization Tip" Foreground="#3B82F6" FontWeight="SemiBold" FontSize="11" />
                            <TextBlock Text="Set Crouch key in game settings to HOLD mode for maximum recovery speed. Supports keyboard keys and side mouse buttons (Mouse4 / Mouse5)." Foreground="#A1A1AA" FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap" LineHeight="15" />
                        </StackPanel>
                    </Border>

                    <!-- Footer Credit Line -->
                    <TextBlock Text="Created with ❤️ by Zcwws • Premium Gaming Utility" HorizontalAlignment="Center" Foreground="#71717A" FontSize="10.5" FontWeight="Medium" Margin="0,2,0,0" />

                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
